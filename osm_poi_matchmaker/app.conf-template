[matcher]
# Database settings
db.type=postgresql
db.write.host=opm_db # This is for container. Feel free to edit to localhost or your PostgreSQL and PostGIS servers name or address.
db.write.port=5432
db.write.username=poi
db.write.password=poitest
db.poi.database=poi
db.enable.analyze=False
db.enable.query_log=False
db.enable.huge_query=True
db.start.drop.poi_tables=True

# Directory settings
dir.output=output
dir.cache_url=cache_url

geo.default.projection=3857
geo.default.poi.distance=70
geo.default.poi.unsafe.distance=5
geo.default.poi.perfect.distance=300
geo.default.poi.road.distance=600
geo.amenity.atm.poi.distance=20
geo.shop.convenience.poi.distance=50
geo.amenity.post.office.poi.distance=200
geo.prefer.osm.postcode=True
geo.alternative.opening.hours=False
geo.alternative.opening.hours.tag=opening_hours:covid19

download.verify.link=True
download.use.cached.data=False

use.general.source.website.date=True
use.general.source.website.date.tag=source:date

# Overrides log.conf's own level=... without editing that file. One of
# DEBUG, INFO, WARNING, ERROR, CRITICAL. Defaults to INFO if unset.
#log.level=DEBUG

dataproviders.limit.elements=None

# MAV's GTFS feed (hu_mav.py) requires HTTP Basic Auth credentials that must NOT be
# committed to git - set these only in your local, untracked app.conf (or via the
# OPM_MAV_GTFS_USERNAME / OPM_MAV_GTFS_PASSWORD environment variables). Without
# either, hu_mav.py falls back to a manually-provided local hu_mav.zip if present.
